# Variables d'environnement du service vault-mcp — DOCUMENTATION UNIQUEMENT (aucune valeur).
# Le fichier réel (mcp.env, 0600, propriété du compte de service) est hors Git.

# Miroir CouchDB du vault Obsidian (lecture/recherche)
COUCH_URL=
COUCH_DB=

# Écoute MCP
MCP_PORT=

# Authentification Bearer (clients) + scopes
VAULT_MCP_TOKEN=
VAULT_MCP_TOKEN_SCOPES=

# Passerelle OAuth colocalisée (issuer public, hash de la phrase de consentement)
VAULT_MCP_ISSUER=
VAULT_MCP_CONSENT_HASH=

# Fonctionnalités (écriture directe autorisée, spool)
VAULT_MCP_ECRITURE=
VAULT_MCP_SPOOL=
