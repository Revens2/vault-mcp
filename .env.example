# Variables d'environnement du service vault-mcp — DOCUMENTATION UNIQUEMENT (aucune valeur).
# Le fichier réel (mcp.env, 0600, propriété du compte de service) est hors Git.

# Miroir CouchDB du vault Obsidian (lecture/recherche)
COUCH_URL=
COUCH_DB=

# Écoute MCP
MCP_PORT=

# Authentification Bearer (clients) + scopes
VAULT_MCP_TOKEN=
VAULT_MCP_TOKEN_SCOPES=

# Passerelle OAuth colocalisée (issuer public, hash de la phrase de consentement)
VAULT_MCP_ISSUER=
VAULT_MCP_CONSENT_HASH=

# Jetons de rafraîchissement OAuth (issue #11), en secondes ; vide = défaut.
#  - REFRESH_TTL_S : durée glissante, renouvelée à chaque rotation (défaut 2592000 = 30 j)
#  - REFRESH_MAX_LIFETIME_S : durée absolue d'une famille / d'un consentement (défaut 7776000 = 90 j)
#  - REFRESH_REUSE_GRACE_S : tolérance de rejeu d'un jeton déjà tourné (défaut 0 = strict, max 300)
# Tout rejeu hors grâce révoque la famille entière. Révocation : POST /revoke (RFC 7009)
# ou scripts/oauth_revoquer.py.
VAULT_MCP_OAUTH_REFRESH_TTL_S=
VAULT_MCP_OAUTH_REFRESH_MAX_LIFETIME_S=
VAULT_MCP_OAUTH_REFRESH_REUSE_GRACE_S=

# Fonctionnalités (écriture directe autorisée, spool)
VAULT_MCP_ECRITURE=
VAULT_MCP_SPOOL=
