# /etc/llm-wiki/opencode-worker.env — worker alternatif LLM Wiki. Aucun secret ici :
# le modele retenu (OpenCode Zen, gratuit) n'exige pas de cle.
# Choix du 2026-09-11 : les prompts/reponses de ce modele gratuit servent a entrainer
# les modeles Meta ; seule la projection caviardee lui est envoyee.
WIKI_ALT_MODEL=opencode/muse-spark-1.3-contributor-free
WIKI_ALT_OPENCODE=/usr/local/lib/opencode/opencode
WIKI_ALT_TIMEOUT=600
OPENCODE_CONFIG=/etc/llm-wiki/opencode-worker.json
OPENCODE_DISABLE_AUTOUPDATE=1
OPENCODE_DISABLE_SHARE=1
OPENCODE_DISABLE_PROJECT_CONFIG=1
OPENCODE_DISABLE_EXTERNAL_SKILLS=1
OPENCODE_DISABLE_CLAUDE_CODE=1
