[Unit]
# Indexation semantique INCREMENTALE du vault (mission perf du 2026-09-10).
#
# Avant : chaque ecriture de note armait un timer transitoire
# (vault-reindex-debounce) qui lancait un FULL rebuild de 165 000 fragments.
# Mesure sur 7 jours : 19 full, 2 h 10 chacun, 2 vCPU satures en permanence sur
# une machine qui en a 4 et qui sert aussi les MCP interactifs.
#
# Maintenant : le pousseur du spool salit les chemins ecrits, ce worker les
# reindexe par lot avec UNE seule publication d'index. Le full de 03:30 reste la
# reconciliation ultime -- il n'est PAS masque, il n'est PAS desactive.
#
# Unite SEPAREE de vault-mcp.service, et pas un thread dedans : depriorise ici,
# on ne depriorise pas en meme temps les recherches interactives du MCP.
Description=Indexation incrementale du vault (file des chemins sales)
Documentation=file:///opt/vault-mcp/scripts/index_worker.py
After=network-online.target vault-mcp.service
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=juliann-app
Group=juliann-app
WorkingDirectory=/opt/vault-mcp
EnvironmentFile=/opt/vault-mcp/mcp.env
Environment=PYTHONPATH=/opt/vault-mcp
Environment=HOME=/opt/vault-mcp
# Meme bridage qu'au full : VAULT_MCP_THREADS est le SEUL levier reconnu par
# onnxruntime (OMP/ORT_NUM_THREADS sont inertes, cf. vault_mcp/embed.py).
Environment=VAULT_MCP_THREADS=2
ExecStart=/opt/vault-mcp/venv/bin/python /opt/vault-mcp/scripts/index_worker.py
# Le worker fait la queue derriere le verrou writer quand le full tourne :
# le delai doit couvrir un full (2 h 10 mesure) plus sa marge.
TimeoutStartSec=4h
StandardInput=null

# Le batch cede le CPU aux requetes interactives, jamais l'inverse.
Nice=10
CPUWeight=30
IOSchedulingClass=idle
CPUQuota=200%

# --- Durcissement, calque sur vault-reindex.service ---
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0007

# Ecriture de l'index et de la file des chemins sales ; le miroir du vault
# reste en LECTURE SEULE -- la source de verite du RAG n'est jamais ecrite ici.
ReadWritePaths=/opt/vault-mcp/index /srv/vault-spool/dirty
ReadOnlyPaths=/srv/vault-mirror
